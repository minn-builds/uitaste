{
  "meta": {
    "id": "editorial",
    "name": "Editorial",
    "description": "Magazine layout: high-contrast Fraunces display over a Source Serif text face, ink on warm paper, one vermilion accent, asymmetric columns separated by hairline rules instead of cards.",
    "tags": ["serif", "magazine", "editorial", "warm", "print", "content"]
  },
  "fonts": {
    "display": {
      "family": "Fraunces",
      "fallback": ["Georgia", "Times New Roman", "serif"],
      "weights": [300, 400, 600]
    },
    "body": {
      "family": "Source Serif 4",
      "fallback": ["Georgia", "Cambria", "serif"],
      "weights": [400, 600]
    },
    "mono": {
      "family": "IBM Plex Mono",
      "fallback": ["ui-monospace", "Menlo", "monospace"],
      "weights": [400, 500]
    }
  },
  "colors": {
    "neutral": "oklch(0.54 0.04 70)",
    "accent": "oklch(0.55 0.17 38)",
    "destructive": "oklch(0.5 0.13 15)"
  },
  "scale": {
    "type": { "base": 18, "ratio": 1.28 },
    "spacing": { "base": 4 }
  },
  "radius": { "sm": 1, "md": 2, "lg": 3 },
  "shadow": { "style": "none" },
  "motion": {
    "duration": { "fast": 120, "base": 200, "slow": 360 },
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "rules": "rules.md",
  "darkMode": true
}
