{
  "name": "@uitaste/mcp",
  "version": "0.1.0",
  "description": "MCP server for uitaste: list presets, generate tokens, lint and screenshot from any MCP client.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minn-builds/uitaste.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/minn-builds/uitaste#readme",
  "bugs": {
    "url": "https://github.com/minn-builds/uitaste/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "design-tokens",
    "lint",
    "claude",
    "ai"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "tsup": "^8.5.1",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@uitaste/core": "workspace:*",
    "@uitaste/skill": "workspace:*",
    "zod": "^4.6.7"
  },
  "bin": {
    "uitaste-mcp": "./dist/main.js"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
