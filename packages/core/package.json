{
  "name": "@uitaste/core",
  "version": "0.1.0",
  "description": "Core of uitaste: preset schema, OKLCH token generator, CSS/Tailwind v4/JSON emitters, design linter and screenshot planner.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uitaste/uitaste.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/uitaste/uitaste#readme",
  "bugs": {
    "url": "https://github.com/uitaste/uitaste/issues"
  },
  "keywords": [
    "design-tokens",
    "tailwind",
    "oklch",
    "design-system",
    "lint",
    "ai",
    "coding-agent"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@babel/types": "^7.29.11",
    "@types/culori": "^4.0.1",
    "tsup": "^8.5.1",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@babel/parser": "^7.29.11",
    "@uitaste/presets": "workspace:*",
    "culori": "^4.0.2",
    "parse5": "^8.0.1",
    "postcss": "^8.5.32",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
