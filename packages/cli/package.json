{
  "name": "uitaste",
  "version": "0.1.0",
  "description": "Make coding agents ship distinctive frontends: design tokens from curated presets, a design linter and a screenshot critique loop.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minn-builds/uitaste.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/minn-builds/uitaste#readme",
  "bugs": {
    "url": "https://github.com/minn-builds/uitaste/issues"
  },
  "keywords": [
    "cli",
    "design-tokens",
    "tailwind",
    "lint",
    "claude-code",
    "cursor",
    "codex",
    "ai",
    "frontend"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "execa": "^9.6.1",
    "playwright": "^1.64.1",
    "tsup": "^8.5.1",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@uitaste/core": "workspace:*",
    "@uitaste/skill": "workspace:*",
    "citty": "^0.2.2",
    "zod": "^4.6.7"
  },
  "bin": {
    "uitaste": "./dist/main.js"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
