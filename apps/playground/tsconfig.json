{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": [
    "src",
    "../../packages/presets/*/examples",
    "vite.config.ts",
    "tastekit-tokens-plugin.ts",
    "tastekit-tokens-plugin.test.ts",
    "vitest.config.ts"
  ]
}
